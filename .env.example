# Core application
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fast_rag
SERVER_SECRET_KEY=replace-with-a-long-random-secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=file-uploader-test

# Redis / Upstash
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# AI model providers
# Anthropic and OhMyGPT routes currently use OPENAI_API_KEY through the configured proxy.
OPENAI_API_KEY=replace-with-openai-or-proxy-api-key
GEMINI_API_KEY=replace-with-gemini-api-key
OPENROUTER_API_KEY=replace-with-openrouter-api-key
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
MOONSHOT_API_KEY=replace-with-moonshot-api-key
DEEPSEEK_API_KEY=replace-with-deepseek-api-key

# Tool providers
GOOGLE_MAP_API_KEY=replace-with-google-maps-server-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-google-maps-browser-api-key
EXA_API_KEY=replace-with-exa-api-key
COZE_API_KEY=replace-with-coze-api-key
BAILIAN_ALI_API_KEY=replace-with-bailian-ali-api-key
WIKIPEDIA_API_USER_AGENT="FastRAG/1.0 (contact@example.com)"

# Optional tool session data
XIAOHONGSHU_COOKIE=

# Optional logging for Vercel + Logflare
LOGFLARE_API_KEY=
LOGFLARE_SOURCE_TOKEN=

# Platform-provided variables, usually not set manually:
# NODE_ENV=development
# VERCEL=
# VERCEL_URL=
# VERCEL_ENV=
# VERCEL_GITHUB_COMMIT_SHA=
